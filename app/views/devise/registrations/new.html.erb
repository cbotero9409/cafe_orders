<% content_for :title, "Sign Up — Cafe Orders" %>

<div class="max-w-md mx-auto">
  <div class="mb-8 text-center">
    <h1 class="text-3xl font-bold text-stone-800">Create Account</h1>
    <p class="text-stone-500 mt-1">Join Cafe Orders</p>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-stone-100 p-8">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
          data: { turbo: false }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4">
        <%= f.label :name, class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name",
              class: "w-full border border-stone-200 rounded-lg px-3 py-2 text-sm
                      focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>

      <div class="mb-4">
        <%= f.label :email, class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email",
              class: "w-full border border-stone-200 rounded-lg px-3 py-2 text-sm
                      focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, class: "block text-sm font-medium text-stone-700 mb-1" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-stone-400 mb-1"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full border border-stone-200 rounded-lg px-3 py-2 text-sm
                      focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full border border-stone-200 rounded-lg px-3 py-2 text-sm
                      focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>

      <%= f.submit "Create Account",
            class: "w-full bg-amber-800 hover:bg-amber-900 text-white font-semibold
                    py-2.5 rounded-xl transition-colors cursor-pointer" %>
    <% end %>

    <div class="mt-6 text-center text-sm text-stone-500">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
