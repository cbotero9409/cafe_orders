<% content_for :title, "Products — Cafe Orders" %>

<div data-controller="products"
    data-products-active-class="<%= tab_active_classes %>"
    data-products-inactive-class="<%= tab_inactive_classes %>">

  <div class="mb-8">
    <h1 class="text-3xl font-bold text-stone-800">Our Menu</h1>
    <p class="text-stone-500 mt-1">Browse and filter our products</p>
  </div>

  <%= form_with url: products_path, method: :get,
        data: { turbo_frame: "products_grid", products_target: "form" },
        class: "flex flex-col sm:flex-row sm:items-center gap-4 mb-6" do |f| %>

    <%= f.hidden_field :filter, value: @filter, data: { products_target: "filterInput" } %>

    <div class="flex gap-2 flex-wrap" role="tablist">
      <% filter_tabs.each do |label, value| %>
        <%= tag.button label,
              type: "button",
              role: "tab",
              class: filter_tab_class(@filter, value),
              data: { action: "click->products#setFilter", filter: value, products_target: "tab" } %>
      <% end %>
    </div>

    <div class="sm:ml-auto">
      <%= f.search_field :q, value: @q,
            placeholder: "Search products…",
            autocomplete: "off",
            data: { action: "input->products#debounce" },
            class: "w-full sm:w-64 px-4 py-2 rounded-lg border border-stone-300 bg-white text-sm shadow-sm
                    focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent
                    placeholder-stone-400" %>
    </div>
  <% end %>

  <%= turbo_frame_tag "products_grid" do %>
    <% if @products.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% @products.each do |product| %>
          <%= render "product", product: product %>
        <% end %>
      </div>

      <p class="mt-6 text-sm text-stone-400 text-right">
        <%= pluralize(@products.size, "product") %>
      </p>
    <% else %>
      <div class="flex flex-col items-center justify-center py-24 text-stone-400">
        <span class="text-6xl mb-4">☕</span>
        <p class="text-lg font-medium">No products found</p>
        <p class="text-sm mt-1">
          <% if @q.present? %>
            No results for "<%= @q %>" — try a different search or filter
          <% else %>
            Try a different filter
          <% end %>
        </p>
      </div>
    <% end %>
  <% end %>
</div>
