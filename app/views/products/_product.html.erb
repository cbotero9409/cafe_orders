<% inactive = !product.active? %>

<article class="<%= inactive ? 'bg-stone-100 border-stone-200 opacity-60' : 'bg-white border-stone-100 hover:shadow-md' %> rounded-2xl shadow-sm border overflow-hidden flex flex-col transition-shadow duration-200"
         data-product-name="<%= product.name.downcase %>">

  <%# Thumbnail placeholder %>
  <div class="<%= inactive ? 'bg-stone-200 grayscale' : 'bg-amber-50' %> flex items-center justify-center h-40 text-5xl select-none">
    ☕
  </div>

  <div class="p-5 flex flex-col flex-1 gap-3">
    <%# Name + availability badge %>
    <div class="flex items-start justify-between gap-2">
      <h2 class="text-base font-semibold <%= inactive ? 'text-stone-400' : 'text-stone-800' %> leading-snug">
        <%= product.name %>
      </h2>
      <% if product.available? %>
        <span class="shrink-0 text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700">
          Available
        </span>
      <% elsif product.active? %>
        <span class="shrink-0 text-xs font-medium px-2 py-0.5 rounded-full bg-red-100 text-red-600">
          Out of stock
        </span>
      <% else %>
        <span class="shrink-0 text-xs font-medium px-2 py-0.5 rounded-full bg-stone-200 text-stone-400">
          Inactive
        </span>
      <% end %>
    </div>

    <%# Description %>
    <% if product.description.present? %>
      <p class="text-sm <%= inactive ? 'text-stone-400' : 'text-stone-500' %> leading-relaxed line-clamp-2">
        <%= product.description %>
      </p>
    <% end %>

    <%# Footer: price + stock %>
    <div class="mt-auto flex items-center justify-between pt-3 border-t <%= inactive ? 'border-stone-200' : 'border-stone-100' %>">
      <span class="text-lg font-bold <%= inactive ? 'text-stone-400' : 'text-amber-700' %>">
        $<%= number_with_delimiter(product.price) %>
      </span>
      <span class="text-xs text-stone-400">
        <%= product.stock %> in stock
      </span>
    </div>
  </div>
</article>
