<%= form_with model: product, class: "space-y-5" do |f| %>
  <% if product.errors.any? %>
    <div class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-3">
      <p class="font-semibold mb-1"><%= pluralize(product.errors.count, "error") %> prevented this product from being saved:</p>
      <ul class="list-disc list-inside">
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= f.text_field :name, autofocus: true,
          class: "w-full border border-stone-200 rounded-lg px-3 py-2 text-sm
                  focus:outline-none focus:ring-2 focus:ring-amber-500" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= f.text_area :description, rows: 3,
          class: "w-full border border-stone-200 rounded-lg px-3 py-2 text-sm
                  focus:outline-none focus:ring-2 focus:ring-amber-500" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :price, class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= f.number_field :price, min: 1, step: 1,
            class: "w-full border border-stone-200 rounded-lg px-3 py-2 text-sm
                    focus:outline-none focus:ring-2 focus:ring-amber-500" %>
    </div>

    <div>
      <%= f.label :stock, class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= f.number_field :stock, min: 0, step: 1,
            class: "w-full border border-stone-200 rounded-lg px-3 py-2 text-sm
                    focus:outline-none focus:ring-2 focus:ring-amber-500" %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border-stone-300 text-amber-700 focus:ring-amber-500" %>
    <%= f.label :active, class: "text-sm text-stone-600" %>
  </div>

  <%= f.submit class: "w-full bg-amber-800 hover:bg-amber-900 text-white font-semibold
                       py-2.5 rounded-xl transition-colors cursor-pointer" %>
<% end %>
