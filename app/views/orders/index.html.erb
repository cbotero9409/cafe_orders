<% content_for :title, "My Orders — Cafe Orders" %>

<div class="max-w-3xl mx-auto">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="text-3xl font-bold text-stone-800">My Orders</h1>
    <%= link_to "← Browse Menu", products_path,
          class: "text-sm text-amber-700 hover:text-amber-900 font-medium transition-colors" %>
  </div>

  <% if @orders.any? %>
    <div class="space-y-4">
      <% @orders.each do |order| %>
        <%= link_to order_path(order), class: "block bg-white rounded-2xl shadow-sm border border-stone-100 p-5 hover:border-amber-200 transition-colors" do %>
          <div class="flex items-center justify-between">
            <div>
              <p class="font-semibold text-stone-800">Order #<%= order.id %></p>
              <p class="text-sm text-stone-400 mt-0.5"><%= order.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
              <p class="text-sm text-stone-500 mt-1"><%= order.order_items.size %> item(s)</p>
            </div>
            <div class="text-right">
              <p class="text-lg font-bold text-amber-800">$<%= number_with_delimiter(order.total_amount) %></p>
              <span class="inline-block mt-1 text-xs font-medium px-2 py-0.5 rounded-full
                <%= order.status == 'pending' ? 'bg-amber-100 text-amber-800' :
                    order.status == 'paid'    ? 'bg-green-100 text-green-800' :
                                                'bg-stone-100 text-stone-600' %>">
                <%= order.status.capitalize %>
              </span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-24 text-stone-400">
      <p class="text-lg font-medium">No orders yet</p>
      <p class="text-sm mt-1">Place your first order from the menu</p>
      <%= link_to "Browse Menu", products_path,
            class: "mt-4 text-amber-700 hover:text-amber-900 font-medium transition-colors" %>
    </div>
  <% end %>
</div>
